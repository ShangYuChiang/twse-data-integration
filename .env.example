# TWSE API 設定
TWSE_BASE_URL=https://www.twse.com.tw/
TWSE_API_TIMEOUT=30
TWSE_MAX_RETRIES=3

# 資料庫設定
DATABASE_URL=postgresql://user:password@localhost:5432/twse_db
# 或使用 SQLite
# DATABASE_URL=sqlite:///./twse_data.db

# 快取設定
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_TYPE=redis
REDIS_URL=redis://localhost:6379

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=logs/twse.log

# API 頻率限制
API_RATE_LIMIT=100
API_RATE_LIMIT_PERIOD=60
